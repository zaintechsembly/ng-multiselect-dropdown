  "license": "MIT",
  "peerDependencies": {
    "@angular/core": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/forms": "^19.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4400",
    "build": "ng build",
    "lint": "ng lint",
    "build:prod": "ng build --configuration production",
    "clear:lib": "rimraf dist-lib",
    "copyfiles": "copyfiles -u 1 './dist-lib/**/*' node_modules/ng-multiselect-dropdown",
    "build:lib": "npm run clear:lib && ng-packagr -p ng-package.json",
    "postbuild:lib": "npm run copyfiles",
    "prepublishOnly": "npm run build:prod",
    "publish": "ngh --no-silent false --name=\"nileshpatel17\" --email=\"nilesh.nvs@hotmail.com\"",
    "deploy": "ng build --configuration production && angular-cli-ghpages --no-silent --repo=https://github.com/NileshPatel17/ng-multiselect-dropdown.git --name=\"Nilesh Patel\" --email=nilesh.nvs@hotmail.com",
    "deployOnly": "angular-cli-ghpages --no-silent --repo=https://github.com/NileshPatel17/ng-multiselect-dropdown.git --name=\"Nilesh Patel\" --email=nilesh.nvs@hotmail.com",
    "contributors:add": "all-contributors add",
    "contributors:generate": "all-contributors generate"
  },
  "keywords": [
    "angular",
    "angular19",
    "angular multiselect dropdown",
    "angular19 multiselect dropdown",
    "ng multiselect dropdown",
    "ng19 multiselect dropdown",
    "multiselect",
    "dropdown",
    "checkbox"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nileshpatel17/ng-multiselect-dropdown.git"
  },
  "bugs": {
    "url": "https://github.com/nileshpatel17/ng-multiselect-dropdown/issues"
  },
